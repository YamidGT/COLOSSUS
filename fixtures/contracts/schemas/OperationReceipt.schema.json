{
  "$defs": {
    "ActionKind": {
      "enum": [
        "approve",
        "reject",
        "rollback",
        "pause",
        "resume",
        "cancel",
        "retry_setup",
        "configure",
        "run"
      ],
      "title": "ActionKind",
      "type": "string"
    },
    "OperationStatus": {
      "enum": [
        "accepted",
        "running",
        "succeeded",
        "failed"
      ],
      "title": "OperationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ActionKind"
    },
    "operation_id": {
      "title": "Operation Id",
      "type": "string"
    },
    "reason_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reason Code"
    },
    "request_hash": {
      "title": "Request Hash",
      "type": "string"
    },
    "resource_ids": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Resource Ids",
      "type": "object"
    },
    "result_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Result Ref"
    },
    "status": {
      "$ref": "#/$defs/OperationStatus"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "operation_id",
    "idempotency_key",
    "request_hash",
    "kind",
    "resource_ids",
    "status",
    "reason_code",
    "created_at",
    "updated_at",
    "result_ref"
  ],
  "title": "OperationReceipt",
  "type": "object"
}
