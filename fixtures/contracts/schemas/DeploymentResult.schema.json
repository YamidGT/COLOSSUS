{
  "$defs": {
    "DeploymentStatus": {
      "enum": [
        "STAGING",
        "OBSERVING",
        "PROMOTED",
        "ROLLBACK_PENDING",
        "ROLLED_BACK",
        "RECOVERY_FAILED",
        "REJECTED"
      ],
      "title": "DeploymentStatus",
      "type": "string"
    },
    "RollbackResult": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Evidence Ids",
          "type": "array"
        },
        "restored_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Restored Digest"
        },
        "status": {
          "enum": [
            "ROLLED_BACK",
            "RECOVERY_FAILED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "restored_digest",
        "status",
        "evidence_ids"
      ],
      "title": "RollbackResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authorization_id": {
      "title": "Authorization Id",
      "type": "string"
    },
    "candidate_digest": {
      "title": "Candidate Digest",
      "type": "string"
    },
    "deployment_id": {
      "title": "Deployment Id",
      "type": "string"
    },
    "generation": {
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "observation_evidence_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Observation Evidence Ids",
      "type": "array"
    },
    "previous_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Digest"
    },
    "readiness_evidence_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Readiness Evidence Ids",
      "type": "array"
    },
    "refreshed_manifest_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Refreshed Manifest Hash"
    },
    "rollback_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/RollbackResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/$defs/DeploymentStatus"
    }
  },
  "required": [
    "deployment_id",
    "authorization_id",
    "previous_digest",
    "candidate_digest",
    "generation",
    "status",
    "readiness_evidence_ids",
    "observation_evidence_ids",
    "rollback_result",
    "refreshed_manifest_hash"
  ],
  "title": "DeploymentResult",
  "type": "object"
}
